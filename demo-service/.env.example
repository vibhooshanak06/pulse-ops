# ─── Demo Service ────────────────────────────────────────────────────────────
APP_ENV=development

# ─── PulseOps SDK config ──────────────────────────────────────────────────────
# Get this API key from the PulseOps dashboard after creating a project
PULSEOPS_API_KEY=po_live_your_api_key_here
PULSEOPS_SERVICE_NAME=demo-service
PULSEOPS_INGESTION_URL=http://localhost:8000/v1/telemetry

# ─── Failure simulation defaults ─────────────────────────────────────────────
# Phase 15 — controlled via API or env vars
SIMULATE_LATENCY=false
SIMULATE_ERRORS=false
LATENCY_SPIKE_MS=2000
ERROR_RATE_PERCENT=0
