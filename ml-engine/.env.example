# ML Engine reads from the same PostgreSQL database as the backend
# but uses a synchronous connection (no asyncpg needed here)
SYNC_DATABASE_URL=postgresql+psycopg2://pulseops_user:pulseops_password@localhost:5432/pulseops

# Anomaly detection tuning (optional — defaults shown)
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05
MIN_DATA_POINTS=10
BASELINE_WINDOW_MINUTES=60
DETECTION_INTERVAL_MINUTES=1
