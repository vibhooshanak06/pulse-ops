# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops_user
POSTGRES_PASSWORD=pulseops_password

# Async URL used by SQLAlchemy at runtime
DATABASE_URL=postgresql+asyncpg://pulseops_user:pulseops_password@localhost:5432/pulseops

# Sync URL used by Alembic for migrations
SYNC_DATABASE_URL=postgresql+psycopg2://pulseops_user:pulseops_password@localhost:5432/pulseops

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# We will use this in Phase 13
OPENAI_API_KEY=sk-...

# ─── Rate Limiting ────────────────────────────────────────────────────────────
TELEMETRY_RATE_LIMIT_PER_MINUTE=1000
