# =============================================================================
# PulseOps AI — Root environment variable reference
# =============================================================================
# Each service has its own .env file. This root file documents every variable
# used across the entire platform for quick reference.
# Copy the relevant section into the service's .env file.
# =============================================================================

# ─── Backend (backend/.env) ───────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops_user
POSTGRES_PASSWORD=pulseops_password

DATABASE_URL=postgresql+asyncpg://pulseops_user:pulseops_password@localhost:5432/pulseops
SYNC_DATABASE_URL=postgresql+psycopg2://pulseops_user:pulseops_password@localhost:5432/pulseops

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=change-this-to-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=sk-...

TELEMETRY_RATE_LIMIT_PER_MINUTE=1000

# ─── ML Engine (ml-engine/.env) ───────────────────────────────────────────────
# SYNC_DATABASE_URL=postgresql+psycopg2://pulseops_user:pulseops_password@localhost:5432/pulseops
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05
MIN_DATA_POINTS=10
BASELINE_WINDOW_MINUTES=60
DETECTION_INTERVAL_MINUTES=1

# ─── Demo Service (demo-service/.env) ─────────────────────────────────────────
PULSEOPS_API_KEY=po_live_your_api_key_here
PULSEOPS_SERVICE_NAME=demo-service
PULSEOPS_INGESTION_URL=http://localhost:8000/v1/telemetry

SIMULATE_LATENCY=false
SIMULATE_ERRORS=false
LATENCY_SPIKE_MS=2000
ERROR_RATE_PERCENT=0

# ─── Frontend (frontend/.env.local — Vite reads this) ─────────────────────────
# Only needed if you want to override the default Vite proxy
VITE_API_URL=http://localhost:8000/v1
